# Optional directory of recorded audit payloads (*.json).
# When set, audit-core runs an extra consistency test against those files.
# SC_AUDIT_FIXTURES=

# Set to 0 only when the provider keys below are real. Any other value, including unset, keeps auth, jobs, and radar on recorded fixtures.
# SCHEMACRAFT_DRY_RUN=

# Supabase project URL. Dashboard → Project Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Dashboard → Project Settings → API. This one is safe in the browser.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role. Dashboard → Project Settings → API. Server only. It bypasses row-level security.
# SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key for the web-search responses API. https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional OpenAI model for radar. Defaults to gpt-4.1. https://platform.openai.com/docs/models
# OPENAI_RADAR_MODEL=gpt-4.1

# Perplexity API key for Sonar. https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=

# Optional Perplexity model for radar. Defaults to perplexity/sonar. https://docs.perplexity.ai
# PERPLEXITY_RADAR_MODEL=perplexity/sonar

# Inngest event key. Inngest dashboard → Manage → Keys.
# INNGEST_EVENT_KEY=

# Inngest signing key. Inngest dashboard → Manage → Keys.
# INNGEST_SIGNING_KEY=

# Public origin of this signed-in app. Use the Vercel domain until the custom host is attached.
# NEXT_PUBLIC_APP_ORIGIN=https://app.schemacraft-ai.site

# Set to 1 only after app.schemacraft-ai.site answers. Until then the audit page hides the radar link and keeps the result card.
# NEXT_PUBLIC_RADAR_APP_LIVE=

# Google sign-in is configured in Supabase → Authentication → Providers, not in this file.
